NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info
SERVICE_NAME=parc-tenant-admin
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql:///parc_tenant_admin
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-characters
APPROVAL_CONSUMER_SERVICES=parc-auth-customer,parc-tenant-admin,parc-ledger,parc-payment,parc-lending,parc-savings
AUTH_JWT_ISSUER=https://auth.parc.invalid
AUTH_JWT_AUDIENCE=tenant-admin
# AUTH_JWT_PUBLIC_KEYS_JSON={"active-kid":"base64-encoded-SPKI-PEM"}
AUTHORIZATION_CACHE_TTL_SECONDS=30
# REDIS_URL=redis://localhost:6379
SHUTDOWN_TIMEOUT_MS=10000
