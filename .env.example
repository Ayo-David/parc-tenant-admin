NODE_ENV=development
HOST=0.0.0.0
PORT=3002
LOG_LEVEL=info
SERVICE_NAME=parc-tenant-admin
SERVICE_VERSION=0.1.0
DATABASE_URL=postgresql:///parc_tenant_admin
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
# Keys administrator-credential idempotency fingerprints (not a service credential).
IDEMPOTENCY_HASH_SECRET=replace-with-at-least-32-random-characters
APPROVAL_CONSUMER_SERVICES=parc-auth-customer,parc-tenant-admin,parc-ledger,parc-payment,parc-lending,parc-savings
AUTH_JWT_ISSUER=https://auth.parc.invalid
# Auth & Customer verification keys for inbound Auth-issued tokens
# (audience parc-tenant-admin): static keys, or the JWKS URL.
AUTH_JWT_PUBLIC_KEYS_JSON={"active-kid":"base64-encoded-SPKI-PEM"}
AUTH_JWKS_URL=http://127.0.0.1:3001/.well-known/jwks.json
AUTHORIZATION_CACHE_TTL_SECONDS=30
# Optional role-metadata cache; in-memory when neither REDIS_URL nor REDIS_SENTINELS is set.
# REDIS_URL=redis://localhost:6379
# Sentinel mode (replaces REDIS_URL): host[:port] per sentinel, port defaults to 6379.
# The service asks Sentinel for the current primary and follows it after failover.
# REDIS_SENTINELS=10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_PASSWORD=replace-with-redis-node-password
# REDIS_SENTINEL_PASSWORD=replace-with-sentinel-password
SHUTDOWN_TIMEOUT_MS=10000
